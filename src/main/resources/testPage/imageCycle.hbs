const root = document.querySelector(":root"); // Get the root element
var index = 0;
var numPics = 0;

const images = {};
const imagePaths = {{{tokenImageURIs}}};
const imageElement = document.querySelectorAll("img.portrait")[0];

function setDimensions(width, height) {
  root.style.setProperty("--portrait-width", width + "px");
  root.style.setProperty("--portrait-height", height + "px");
}

function init(){
    addEntry(imageElement.src);
    for(const sourceURL of imagePaths){
        addEntry(sourceURL);
    }
}

function addEntry(sourceURL){
    if(!images.hasOwnProperty(sourceURL)){
        loadPic(sourceURL);
    }
}

function cycleImage(increment){
    index+= increment;
    if(index < 0){
        index = numPics - 1;
    } else if(index > numPics - 1){
        index = 0;
    }
    const url = Object.keys(images)[index];
    setDimensions(images[url].width, images[url].height);
    imageElement.src = url;
}

async function loadPic(url) {
    const options = { method: "GET" };
    let response = await fetch(url, options);
    if (response.status === 200) {
        const imageBlob = await response.blob()
        const imageObjectURL = URL.createObjectURL(imageBlob);

        const image = document.createElement('img');
        image.src = imageObjectURL;
        image.addEventListener("load", function() {
            images[image.src] = {
            width: image.naturalWidth,
            height: image.naturalHeight
            };
            numPics++;
        });
<!--        const container = document.head;-->
<!--        container.append(image);-->
    } else {
        console.log("HTTP-Error: " + response.status)
    }
}

window.addEventListener("load", function () {
    for(const url of imagePaths){
        loadPic(url);
    }
    window.addEventListener("keydown", function (event) {
        switch(event.key){
            case "[": cycleImage(-1);
            case "]": cycleImage(1);
        }
    });
    init();
});