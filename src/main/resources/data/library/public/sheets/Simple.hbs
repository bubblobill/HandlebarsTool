<html lang="en-AU">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, height=device-height, user-scalable=0, initial-scale=1"/>
    <link rel="stylesheet" href="lib://net.rptools.maptool/css/mt-stat-sheet.css"/>
    <link rel="stylesheet" href="./css/generic.css"/>
    <link rel="stylesheet" href="./css/simple.css"/>
    <title></title>
</head>
<body>
<div id="statSheet" class="{{statSheetLocation}}">
    <div class="portrait">
        {{#if portrait}}
            <img src="{{portrait}}"
                width="{{portraitWidth}}"
                height="{{portraitHeight}}"
                alt="D'oh!"

            />
        {{else if image}}
            <img src="{{image}}"
                width="{{portraitWidth}}"
                height="{{portraitHeight}}"
                alt="D'oh!"
            />
        {{/if}}
        <div class="nameDetails">
            <div class="tokenName">{{{name}}}</div>
            {{#if gmName}}
                <div class="tokenGmName">({{gmName}})</div>
            {{/if}}
        </div>
    </div>
<div class="statDetails">
<ul class="propertyList">
{{#each properties}}
    {{#neq this.value ""}}
    <li class="{{#if this.gmOnly}}gmProperty{{else}}playerProperty{{/if}}">
            {{~#if this.displayName~}}
                {{~this.displayName~}}
            {{else}}
                {{~#if this.shortName~}}
                    {{~this.shortName~}}
                {{else}}
                    {{~this.name~}}
                {{/if~}}
            {{/if}} : {{{this.value}}}
    </li>
    {{/neq}}
    {{/each}}
</ul>
</div>
</div>
</body>
</html>